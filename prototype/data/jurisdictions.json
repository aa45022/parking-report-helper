      "url": "https://prsweb.tcpd.gov.tw/",
      "auth_summary": "沒有圖形驗證碼。第一次要按「發送認證信」，30 分鐘內到信箱點連結；同一個信箱認證過，之後就不用再認證。",
      "district_options": ["中正一區", "中正二區", "大同區", "中山區", "松山區", "大安區", "萬華區", "信義區", "士林區", "北投區", "內湖區", "南港區", "文山一區", "文山二區", "捷運站"],
      "district_split_note": "中正區、文山區在官方選單分成「一區、二區」，依警察分局轄區劃分，系統還無法自動判斷，請自己選。",
      "violation_labels": {
        "sidewalk_parking": "汽車於人行道、行人穿越道停車(但機車及騎樓不在此限)",
        "crosswalk_parking": "汽車於人行道、行人穿越道停車(但機車及騎樓不在此限)",
        "sidewalk_temp_stop": "汽車於人行道、行人穿越道臨時停車(但機車及騎樓不在此限)",
        "crosswalk_temp_stop": "汽車於人行道、行人穿越道臨時停車(但機車及騎樓不在此限)"
      },
      "vehicle_type_label": "一般(汽、機車)",
      "description_max_length": 200,
      "steps": [
        {
          "title": "第 1 步：檢舉人資料",
          "fields": [
            { "label": "身分證或居留證號", "source": "profile.idNumber" },
            { "label": "姓名", "source": "profile.name" },
            { "label": "聯絡電話", "source": "profile.phone" },
            { "label": "地址", "source": "profile.address" },
            { "label": "電子信箱", "source": "profile.email", "note": "第一次使用要按「發送認證信」，到信箱點連結" }
          ]
        },
        {
          "title": "第 2 步：違規內容",
          "fields": [
            { "label": "違規日期", "source": "case.date", "note": "下拉選單，只列今天往前 7 天" },
            { "label": "違規時間", "source": "case.time" },
            { "label": "行政區", "source": "case.districtLabel", "note": "下拉選單" },
            { "label": "路段", "source": "case.road", "note": "下拉選單，可以打字搜尋" },
            { "label": "巷弄號／交叉路口／地點備註", "source": "case.locationDetail", "note": "三選一，至少要填一個" },
            { "label": "車種", "source": "case.vehicleTypeLabel" },
            { "label": "車號（前段）", "source": "case.plateFront" },
            { "label": "車號（後段）", "source": "case.plateBack" },
            { "label": "違規事實", "source": "case.violationLabel", "note": "下拉選單，選這一項" },
            { "label": "違規事實說明", "source": "case.description", "note": "最多 200 字" }
          ]
        },
        {
          "title": "第 3 步：上傳照片",
          "fields": [
            { "label": "附件", "source": "static", "value": "從「照片」選原始照片，最多 5 張，合計 80MB 內。官方建議用 JPEG。" }
          ]
        }
      ],
      "upload": { "max_files": 5, "max_total_mb": 80, "formats": ["jpg", "jpeg", "png", "bmp", "tiff", "mov", "wmv", "avi", "mp4", "3gp", "ts"] },
      "result_note": "送出後會拿到「案件編號（TP 開頭）」和「查詢密碼」，請記回這裡。",
      "sources": ["https://prsweb.tcpd.gov.tw/", "https://github.com/iroowu/traffic-violation-reporter"]
    },
